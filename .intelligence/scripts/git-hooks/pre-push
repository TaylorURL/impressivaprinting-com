#!/usr/bin/env bash
_ai_tool="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../tools" && pwd)/ai-attribution-guard.py"
_ai_payload="$(cat)"
printf '%s\n' "$_ai_payload" | python3 "$_ai_tool" hook-pre-push || exit $?
exec 0< <(printf '%s\n' "$_ai_payload")
# Refuses a push of a branch that replays work develop has already taken.
#
# Every other guard in this setup is a PreToolUse hook on the Bash tool, so a
# script that shells out from Python escapes all of them: that is how twenty-four
# branches went out cut from an already-merged branch with a base guard sitting
# right there. git runs this one whoever calls git, which is the property the
# harness hooks cannot have.
#
# The test is patch equivalence, not ancestry. A branch is legitimately behind
# develop the moment anyone else merges, so "contains all of develop" refuses
# almost every honest push. What is never legitimate is carrying a commit develop
# already has under another hash alongside new work: those are the commits that
# conflict on files nobody touched. git cherry marks the former with a leading
# minus and the latter with a plus, and a branch holding both is one cut from a
# branch that has since been squashed.
#
# A repo keeping its own pre-push still gets it: core.hooksPath replaces the
# repo's hook directory rather than adding to it, so the repo's hook runs from
# here or it stops running at all.
#
# INTELLIGENCE_ALLOW_ANY_BASE=1 pushes regardless.
set -uo pipefail

repo_hook="$(git rev-parse --git-dir 2>/dev/null)/hooks/pre-push"
if [ -x "$repo_hook" ] && ! [ "$repo_hook" -ef "$0" ]; then
    "$repo_hook" "$@" || exit $?
fi

[ -n "${INTELLIGENCE_ALLOW_ANY_BASE:-}" ] && exit 0

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
case "$branch" in
    ""|HEAD|main|master|develop) exit 0 ;;
esac

git show-ref --verify --quiet refs/remotes/origin/develop || exit 0

cherry="$(git cherry origin/develop HEAD 2>/dev/null)" || exit 0
[ -z "$cherry" ] && exit 0

replayed="$(printf '%s\n' "$cherry" | grep -c '^-' || true)"
fresh="$(printf '%s\n' "$cherry" | grep -c '^+' || true)"

if [ "$replayed" -eq 0 ] || [ "$fresh" -eq 0 ]; then
    exit 0
fi

cat >&2 <<MESSAGE
BLOCKED: $branch replays $replayed commit(s) develop already has.

$(printf '%s\n' "$cherry" | grep '^-' | head -5 | while read -r _ sha; do
    printf '  already on develop  %s\n' "$(git log -1 --format='%h %s' "$sha" 2>/dev/null)"
done)
$(printf '%s\n' "$cherry" | grep '^+' | head -5 | while read -r _ sha; do
    printf '  new here            %s\n' "$(git log -1 --format='%h %s' "$sha" 2>/dev/null)"
done)

This branch was cut from a branch that has since been squashed into develop, so
its pull request conflicts on files nobody touched. Rebuild it on develop:

  git fetch origin
  git checkout -B $branch origin/develop
  # reapply the change, then push

INTELLIGENCE_ALLOW_ANY_BASE=1 pushes anyway.
MESSAGE
exit 1
