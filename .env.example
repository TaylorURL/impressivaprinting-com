# The app ships with the production Supabase project's URL and publishable
# key baked into src/app/data/supabaseClient.js (they are public by design —
# row level security is the actual boundary). Set these only to point a build
# at a different project, e.g. a staging branch.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
